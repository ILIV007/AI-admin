{
  "name": "ai-admin",
  "version": "2.15.6",
  "description": "AI Admin V2 — Telegram channel content processing bot on Cloudflare Workers (free tier)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ai-admin",
    "db:migrate": "wrangler d1 execute ai-admin --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute ai-admin --remote --file=./schema.sql",
    "queue:create": "wrangler queues create ai-admin-queue && wrangler queues create ai-admin-dlq",
    "kv:create": "wrangler kv namespace create AI_ADMIN_KV",
    "secret:bot": "wrangler secret put BOT_TOKEN",
    "secret:webhook": "wrangler secret put WEBHOOK_SECRET",
    "secret:gemini": "wrangler secret put GEMINI_API_KEY",
    "secret:openrouter": "wrangler secret put OPENROUTER_API_KEY",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.114.0"
  }
}
